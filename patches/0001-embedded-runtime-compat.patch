+// A reset controller can retain a per-device row. Such a row is disabled,
+// not a competing I/O policy. Unknown nonempty data is conservatively active.
+fn io_controller_active(name: &str, text: &str) -> bool {
+    text.lines().any(|line| {
+        let mut fields = line.split_whitespace();
+        let device = match fields.next() {
+            Some(device) => device,
+            None => return false,
+        };
+        match device.split_once(':') {
+            Some((major, minor)) if !major.is_empty() && !minor.is_empty()
+                && major.bytes().all(|c| c.is_ascii_digit())
+                && minor.bytes().all(|c| c.is_ascii_digit()) => {}
+            _ => return true,
+        }
+        let mut found = false;
+        for field in fields {
+            found = true;
+            let (key, value) = match field.split_once('=') {
+                Some(pair) => pair,
+                None => return true,
+            };
+            let disabled = match name {
+                "io.max" => matches!(key, "rbps" | "wbps" | "riops" | "wiops") && value == "max",
+                "io.latency" => key == "target" && value == "0",
+                "io.low" => matches!(key, "rbps" | "wbps" | "riops" | "wiops") && value == "0",
+                _ => false,
+            };
+            if !disabled {
+                return true;
+            }
+        }
+        !found
+    })
+}
 
