+/// calibration state. Timestamp prevents PID reuse from concealing replacement.
+fn validate_balloon_identity(
+    state: &systemd::UnitState,
+    pid: Option<u32>,
+    started: Option<u64>,
+    restart: Option<&str>,
+    swap_max: Option<u64>,
+    previous: Option<(u32, u64)>,
+) -> Result<(u32, u64)> {
+    if *state != systemd::UnitState::Running || restart != Some("no") || swap_max != Some(0) {
+        bail!("balloon: allocation lost or overridden lifetime/swap policy; measurements invalid");
+    }
+    let current = match (pid, started) {
+        (Some(pid), Some(started)) if pid > 0 && started > 0 => (pid, started),
+        _ => bail!("balloon: missing process identity; measurements invalid"),
+    };
+    if previous.map_or(false, |old| old != current) {
+        bail!("balloon: process restarted outside native resize; measurements invalid");
+    }
+    Ok(current)
